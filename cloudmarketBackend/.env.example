# Copie para .env (NÃO versionar) ou configure no painel do Render.

# Banco (Neon): use o formato JDBC
DATABASE_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=troque-aqui

# URLs públicas
FRONTEND_URL=https://cloudmarket.vercel.app
BACKEND_URL=https://cloudmarket-bff.onrender.com

# Pagamento: fake (padrão) ou mercadopago
PAYMENT_PROVIDER=fake
# Só se PAYMENT_PROVIDER=mercadopago — use SEMPRE a credencial de TESTE
MERCADOPAGO_ACCESS_TOKEN=

SPRING_PROFILES_ACTIVE=prod
